+def validate_desktop_ui(ui_root: Path) -> list[str]:
+    """Reject missing or unbuilt frontend assets before displaying an empty window."""
+    root = ui_root.resolve()
+    index = root / 'index.html'
+    if not index.is_file():
+        raise DesktopAssetError(
+            f'Desktop UI is missing index.html in {root}. '
+            'The Python desktop launcher needs built static UI assets, not React source. '
+            'Build frontend-second with `npm ci` and `npm run build` first.'
+        )
+    try:
+        html = index.read_text(encoding='utf-8')
+    except (UnicodeError, OSError) as exc:
+        raise DesktopAssetError(f'Desktop index.html is unreadable: {index}: {exc}') from exc
+    parser = _UiReferences()
+    parser.feed(html)
+    if any(path.lower().endswith(('.tsx', '.jsx', '.ts')) or path.startswith('src/') for path in parser.paths):
+        raise DesktopAssetError(
+            f'{index} points to uncompiled React source files. '
+            'Run `npm ci` and `npm run build` in frontend-second, then use frontend-second/dist.'
+        )
+    if not parser.paths:
+        raise DesktopAssetError(
+            f'Desktop index.html references no scripts or styles: {index}. '
+            'Check the built frontend assets.'
+        )
+    missing: list[str] = []
+    for relative in parser.paths:
+        candidate = (root / relative).resolve()
+        if not relative or not candidate.is_relative_to(root) or not candidate.is_file():
+            missing.append(relative)
+    if missing:
+        raise DesktopAssetError(
+            f'Desktop UI has missing startup resources in {root}: {", ".join(missing)}. '
+            'Restore a complete UI build before launching.'
+        )
+    return parser.paths
+
