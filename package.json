{
  "name": "openagent-react-console",
  "private": true,
  "type": "module",
  "version": "0.13.0",
  "scripts": {
    "dev": "npm run dev:web",
    "start": "npm run dev:web",
    "dev:web": "npm --prefix frontend-second run dev",
    "dev:web:legacy": "vite --config frontend/vite.config.ts",
    "build:web": "npm --prefix frontend-second run build",
    "check:web": "npm --prefix frontend-second run check",
    "test:web": "npm --prefix frontend-second test",
    "test:web:legacy": "vitest run --config frontend/vitest.config.ts",
    "test:e2e": "npm --prefix frontend-second run test:e2e",
    "capture:web:evidence": "node scripts/capture-ui-evidence.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@types/node": "^22.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.9.2",
    "unocss": "^66.11.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@arco-design/web-react": "^2.66.18",
    "@icon-park/react": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "lucide-react": "^1.56.0",
    "motion": "^14.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
