{
  "name": "openagent-react-console",
  "private": true,
  "type": "module",
  "version": "0.13.0",
  "scripts": {
    "dev:web": "vite --config frontend/vite.config.ts",
    "build:web": "npm run check:web && vite build --config frontend/vite.config.ts",
    "check:web": "tsc -p ./frontend/tsconfig.json --noEmit",
    "test:web": "vitest run --config frontend/vitest.config.ts",
    "test:e2e": "npm run build:web && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@types/node": "^22.0.0",
    "autoprefixer": "^10.6.1",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
