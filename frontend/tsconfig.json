{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "allowJs": false, "checkJs": false, "esModuleInterop": true, "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true, "skipLibCheck": true, "sourceMap": true, "baseUrl": ".", "jsx": "react-jsx",
    "paths": { "@/*": ["src/*"] }, "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}
